*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ── Environment ──────────────────────────────────────────
.env
.env.local

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

